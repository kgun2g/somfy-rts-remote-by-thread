CONFIG_SUPPORT_WINDOW_COVERING_CLUSTER=y
# RMT: ws2812 LED(legacy 드라이버) + Somfy RF(new driver_ng) 공존 허용 —
#  충돌 체크/deprecate 경고 끔. C6 sdkconfig 에만 있고 defaults 엔 빠져 있어
#  새 보드 set-target 시 부트루프(rmt_legacy.c check_rmt_legacy_driver_conflict abort)났음.
CONFIG_RMT_SUPPRESS_DEPRECATE_WARN=y
CONFIG_RMT_SKIP_LEGACY_CONFLICT_CHECK=y
CONFIG_SUPPORT_WATER_HEATER_MANAGEMENT_CLUSTER=n
CONFIG_SUPPORT_WATER_HEATER_MODE_CLUSTER=n
CONFIG_SUPPORT_ELECTRICAL_GRID_CONDITIONS_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_PRICE_CLUSTER=n
CONFIG_SUPPORT_METER_IDENTIFICATION_CLUSTER=n
CONFIG_SUPPORT_UNIT_LOCALIZATION_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_METERING_CLUSTER=n
CONFIG_SUPPORT_COMMODITY_TARIFF_CLUSTER=n
CONFIG_SUPPORT_PUSH_AV_STREAM_TRANSPORT_CLUSTER=n

# ── Matter OTA: 디바이스 소프트웨어 버전 (OTA 비교 기준; PROJECT_VER_NUMBER 와 정합) ──
CONFIG_DEVICE_SOFTWARE_VERSION_NUMBER=35
CONFIG_BLE_DEVICE_NAME_PREFIX="MATTER-"
CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"

# ★★2026-08-20 컴파일 최적화 -Og → -Os (절전).
#  그동안 IDF 기본값인 -Og(디버그 최적화)로 빌드되고 있었다 — 어느 defaults 에도
#  적어두지 않아 눈치채지 못했다.
#  배터리 실측(NVS 계측): 깨어남 88회/초, 회당 깨어있음 1.52ms
#      = 실작업 0.70ms + light sleep 진입/복귀 오버헤드 0.82ms
#  -Os 는 그 **양쪽을 함께** 줄인다(코드가 빨라지므로). 주기를 건드리지 않으므로
#  반응 지연이 생기지 않는다 — 폴 주기 25→100ms 시도는 "너무 느리다"로 되돌렸다.
#  ★-O2(PERF)를 쓰지 않은 이유: 현재 .bin 이 앱 파티션의 92% 라 여유가 8% 뿐이다.
#    -O2 는 코드가 커져 넘칠 위험이 있고, -Os 는 오히려 줄어든다.
#  ★어서션은 그대로 켜 둔다(ASSERTION_LEVEL=2) — 미해결 건(2129mV 오독,
#    인터럽트 워치독 리셋)이 남아 있어 진단 능력을 포기할 때가 아니다.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# ★★2026-08-20 상시 계측 끄기 (절전 ②).
#  측정하려고 켜 뒀던 것들인데, 켜져 있는 동안 **모든 태스크 전환·모든 PM lock
#  획득/해제·sleep 진입마다** 타이머를 읽어 누적한다. 측정은 끝났다.
#    · PM_PROFILING            : PM lock 보유시간 통계 (콘솔 `pm` 이 덜 자세해짐)
#    · GENERATE_RUN_TIME_STATS : 태스크별 CPU 점유 (콘솔 `rt` 비활성 — 이미 #if 가드 있음)
#    · USE_STATS_FORMATTING_FUNCTIONS : 위 통계의 문자열 포맷 함수
#  ★USE_TRACE_FACILITY 는 **켜 둔다** — uxTaskGetSystemState 가 이걸 요구하고,
#    per-switch 비용이 없다(TCB 필드만 늘린다). 끄면 app_main.cpp 의 `rt` 가
#    가드로 빠지긴 하지만, 굳이 기능을 더 없앨 이유가 없다.
#  다시 재려면 이 세 줄을 지우고 재빌드하면 된다.
CONFIG_PM_PROFILING=n
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=n
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=n

# ★★2026-08-22 802.15.4 무선을 light sleep 중 전원 차단 (절전 ④).
#  근거: 실측상 **시간의 89.5% 가 수면**인데 그 동안 무선이 계속 켜져 있었다.
#  지금까지의 절전(-Os, 계측 끄기)은 깨어있는 10.5% 만 깎은 것이라, 비중이
#  8.5배 큰 쪽을 안 건드린 셈이었다.
#  ★ESP_PHY_MAC_BB_PD 가 아니다 — 그쪽 도움말은 "Wi-Fi and Bluetooth" 이고
#    RAM 을 2~4KB 더 먹는다. 우리는 Wi-Fi 미사용·BLE 는 페어링 때만 쓰므로
#    이득 없이 RAM 만 낭비한다. Thread(802.15.4)에 작용하는 건 이 옵션이다.
#  ★위험: SED/ICD 는 부모 라우터가 메시지를 버퍼링했다가 폴링 때 넘겨주므로
#    이론상 명령 유실이 없다. 다만 IDF Kconfig 에 "Todo: Remove when support
#    safe power-down of the power domain (IDF-7317)" 라는 단서가 붙어 있어
#    **실기 검증이 필수**다. 명령 누락·지연·재접속 실패가 보이면 즉시 n 으로.
CONFIG_IEEE802154_SLEEP_ENABLE=y
