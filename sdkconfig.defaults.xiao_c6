# ──────────────────────────────────────────────────────────
# sdkconfig.defaults.xiao_c6
#   Seeed XIAO ESP32-C6 보드 오버레이 — c6_thread 위에 마지막으로 적용.
#   브랜드별 고유 Product ID 만 지정(나머지는 c6_thread 공통).
#   GNPE(0x8000) 와 구분돼야 Matter OTA 가 보드별 이미지를 매칭한다.
#   (같은 SoC esp32c6 라 chip-ID 로는 구분 불가 → PID 가 유일 식별자.)
# ──────────────────────────────────────────────────────────
CONFIG_DEVICE_PRODUCT_ID=0x8003

# ── OLED: 외부 0.96" SSD1306 128×64 (정방향) ──
#   GNPE 0.42" 72×40(SEG28~99, OFFSETX=28)과 달리 표준 128×64 → 컬럼 오프셋 0.
#   (c6_thread 가 CONFIG_OFFSETX=28 로 두므로 여기서 0 으로 덮어쓴다.)
#   해상도·회전·72×40 보정은 boards/xiao-c6.h 의 BOARD_OLED_* 가 결정.
CONFIG_SSD1306_128x64=y
CONFIG_OFFSETX=0
# CONFIG_FLIP is not set
CONFIG_BLE_DEVICE_NAME_PREFIX="MATTER-"
CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"

# ── ★2026-08-11 브라운아웃 검출 감도 상향 (배터리 부팅 멈춤 진단/보호) ──
#   증상: USB 없이 배터리만 연결하면 부팅 중 조용히 멈춘다(리셋 없음).
#   근거: boot_diag 기록상 리셋사유가 항상 "전원투입"이고 브라운아웃/패닉/워치독이
#         한 번도 안 찍혔는데, 멈추는 지점은 매번 달랐다(105ms, 979ms …).
#         특정 코드 버그라면 같은 곳에서 멈춰야 하므로 전원 쪽이 유력하다.
#   왜 안 잡혔나: IDF 기본 LVL 7 = **2.51V** 로 C6 에서 가장 둔감한 설정이다.
#         그런데 ESP32-C6 동작 최소 전압은 3.0V, SPI 플래시는 보통 2.7V 이상이
#         필요하다 → 레일이 2.7~3.0V 로 처지면 CPU/플래시는 오동작하지만
#         검출기는 안 울려 **리셋 없이 조용히 멈춘다**. 관측과 정확히 일치.
#   조치: 2.92V(LVL 4)로 올린다. 전원이 원인이면 조용한 멈춤 대신
#         "★브라운아웃" 리셋으로 바뀌어 boot_diag 에 기록된다(= 원인 확정).
#         원인이 아니면 여전히 멈추므로 전원 가설이 탈락한다. 어느 쪽이든 답이 나온다.
#   ※정상 레일은 3.3V 라 0.4V 여유가 있어 오검출 위험은 낮다.
#     되돌리려면 이 두 줄을 지우면 IDF 기본(2.51V)으로 복귀한다.
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y
CONFIG_ESP_BROWNOUT_DET_LVL=4
