# ──────────────────────────────────────────────────────────
# sdkconfig.defaults.xiao_c6
#   Seeed XIAO ESP32-C6 보드 오버레이 — c6_thread 위에 마지막으로 적용.
#   브랜드별 고유 Product ID 만 지정(나머지는 c6_thread 공통).
#   GNPE(0x8000) 와 구분돼야 Matter OTA 가 보드별 이미지를 매칭한다.
#   (같은 SoC esp32c6 라 chip-ID 로는 구분 불가 → PID 가 유일 식별자.)
# ──────────────────────────────────────────────────────────
CONFIG_DEVICE_PRODUCT_ID=0x8003

# ── OLED: 외부 0.96" SSD1306 128×64 (정방향) ──
#   GNPE 0.42" 72×40(SEG28~99, OFFSETX=28)과 달리 표준 128×64 → 컬럼 오프셋 0.
#   (c6_thread 가 CONFIG_OFFSETX=28 로 두므로 여기서 0 으로 덮어쓴다.)
#   해상도·회전·72×40 보정은 boards/xiao-c6.h 의 BOARD_OLED_* 가 결정.
CONFIG_SSD1306_128x64=y
CONFIG_OFFSETX=0
# CONFIG_FLIP is not set
CONFIG_BLE_DEVICE_NAME_PREFIX="MATTER-"
CONFIG_CHIP_PROJECT_CONFIG="main/CHIPProjectConfig.h"

# ── ★2026-08-11 배터리 수명 개선 (사용자 요청 A+B) ─────────────────────────
#   측정: 배터리 단독 84mA → 700mAh 로 약 8시간. 원인 두 가지가 지배했다.
#     · CONFIG_OPENTHREAD_FTD  : Full Thread Device 는 다른 노드를 중계해야 해서
#                                802.15.4 수신부를 **끌 수 없다**(~70mA).
#     · CONFIG_PM_ENABLE 미설정 : light sleep·주파수 스케일링이 전부 꺼져 CPU 가
#                                160MHz 로 상시 동작.
#   조치:
#     · MTD(Minimal Thread Device) + Matter ICD 서버 → **Sleepy End Device**.
#       폴링 사이에 라디오를 끈다. 리모컨은 중계 역할이 필요 없어 기능 손해가 없다.
#       대가: 앱(SmartThings) 명령이 폴링 주기만큼 지연된다(버튼 조작은 즉시).
#     · PM_ENABLE + tickless idle → CPU 도 유휴 시 잠든다.
#   ★주의: 커미셔닝 도중에는 light sleep 을 켜면 안 된다(Thread operational 단계를
#     굶겨 페어링이 마지막에 실패한 이력) → somfy_app.c 가 커미셔닝 완료 후에만
#     _enable_pm_light_sleep() 을 부르는 게이트를 이미 갖고 있다. 그대로 둘 것.
# CONFIG_OPENTHREAD_FTD is not set
CONFIG_OPENTHREAD_MTD=y
CONFIG_ENABLE_ICD_SERVER=y
# ★ICD 서버만 켜면 링크가 깨진다 — 클러스터 구현(ZAP 생성 콜백)이 빌드에서 빠져
#   `undefined reference to MatterIcdManagementPluginServerInitCallback` 이 난다.
#   esp-matter 는 클러스터를 CONFIG_SUPPORT_*_CLUSTER 로 개별 선택하므로 같이 켜야 한다.
CONFIG_SUPPORT_ICD_MANAGEMENT_CLUSTER=y
CONFIG_ICD_SLOW_POLL_INTERVAL_MS=7000
# ★★2026-08-13 IdleModeDuration 2 -> 30 초.
#  CHIP 은 구독 최대주기를 **이 값으로 협상**한다(ReadHandler.cpp:
#  "synchronize the subscription report interval with the IdleModeDuration").
#  esp-matter 기본값 2 여서 SmartThings 구독이 Min=0s/Max=2s 로 잡혔고,
#  절전 기기가 2초마다 보고를 강요당해 light sleep 이 무의미해졌다
#  (실측: IM:ReportData 가 2.02초 간격으로 무한 반복). 배터리로 돌리면
#  그 약속을 못 지켜 허브가 offline 판정 → 실사용 신고와 일치.
#  ※하향 링크 지연은 SLOW_POLL(7초)이 정하므로 이 값과 무관 — 명령 반응은 그대로다.
CONFIG_ICD_IDLE_MODE_INTERVAL_SEC=30

# ★★★2026-08-14 FreeRTOS tick — 100Hz 로 내려 실측했으나 **차이 없음** → 1000Hz 유지
#
#  【3회 실측, 동일 전압구간 기울기】(전체평균 % 로 비교하면 안 된다 — 아래 절 참조)
#     구간        #22 100Hz·LP없음   #32 1000Hz·LP   #33 100Hz·LP
#     3790~3830   -0.64 mV/분        -0.71           -1.00
#     3620~3800   -0.64 (28분뿐)     -0.94           -0.95   ← 표본 긴 구간
#     3700~3790   -0.80 (10분뿐)     -0.75           -0.75   ← 표본 긴 구간, 완전 동일
#   ⇒ **표본이 긴 구간에서는 100Hz 와 1000Hz 가 구별되지 않는다.**
#     짧은 구간에서 #33 이 나빠 보이는 건 세션 시작 직후(표면전하 방전)가 섞인 탓.
#   ⇒ "①이 악화 원인"이라는 앞선 추정은 **데이터로 뒷받침되지 않았다**. 철회한다.
#     세 세션 공통 결론은 하나뿐 — 어떤 설정이든 60~80mA 에서 안 움직인다.
#     ①·③ 모두 CPU 쪽이고, 지배 항목(라디오 상시 RX)은 아직 손대지 않았다.
#
#  【그래도 1000Hz 를 쓰는 이유】 tick 해상도가 필요한 곳이 있고(아래 ★),
#   절전 면에서 둘이 구별되지 않으므로 기존 값을 유지한다. 사용자 결정(2026-08-14).
#
#  ★tick 을 다시 건드릴 때 **반드시** 확인할 것: `pdMS_TO_TICKS` 는 정수 내림이라
#   100Hz 에서 10ms 미만 대기가 **0 tick = 소멸**한다(vTaskDelay(0)=yield).
#   그래서 아래 4곳은 이미 `esp_rom_delay_us()` 로 바꿔 tick 무관하게 만들어 뒀다:
#     somfy_rts.c:339/415 (5ms VCO/PA settle — SDR 실측으로 넣은 것),
#     cc1101.c:365 (2ms SCAL), somfy_app.c:3399 (3ms CHG_STAT 풀업 안정).
#   새로 짧은 vTaskDelay 를 추가하면 같은 함정에 빠진다 —
#   검사 도구: sim/tools/tick_rate_rf_sim.py
#
#  ※light sleep 문턱(FREERTOS_IDLE_TIME_BEFORE_SLEEP)은 FreeRTOS 최소값이 2라
#   더 못 낮춘다. 1000Hz 에서 3 tick = 3ms.
CONFIG_FREERTOS_HZ=1000
CONFIG_ICD_FAST_POLL_INTERVAL_MS=200
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# ★★2026-08-13 (③) LP 코어로 PCF8574 폴링 위임 — 절전
#  근거: 실측 57mA/12.3h 의 주범은 HP 가 10ms 마다 깨어나 PCF 를 비트뱅 I2C 로
#  읽는 것(초당 100회). `~INT` 이벤트 구동(②)은 실측 불가 판정
#  (버튼을 눌러도 선이 안 움직임 — 표본 290,023 / 전이 0회).
#  → 폴링 주체를 LP 코어로 옮긴다. 로터리 쿼드러처도 LP 에서 디코딩한다
#    (디텐트는 수 ms 안에 끝나 HP 가 깨어나서 읽으면 방향을 알 수 없다).
#  ※LP_I2C 는 C6 에서 SDA=GPIO6/SCL=GPIO7 **고정**. 이 배선인 개체에서만 쓰이고,
#    앞면 공유 I2C(22/23)로 폴백된 개체는 런타임 판정으로 걸러져 현행 폴링 유지.
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_LP_CORE=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096

# ★★★2026-08-14 BLE 를 커미셔닝에만 쓰고 등록 후 해제 (절전 — 실측 근거)
#
#  【실측】 콘솔 `pm`(esp_pm_dump_locks, CONFIG_PM_PROFILING=y):
#      bt       APB_FREQ_MAX  Active=1  Total_count=1  **100%**
#      Mode stats: CPU_MAX 99% — **light sleep 진입 0회**
#    BLE 스택이 부팅 때 APB_FREQ_MAX 락을 한 번 잡고 영원히 안 놓는다.
#    APB_FREQ_MAX 를 쥐고 있으면 automatic light sleep 은 진입 자체가 불가하다.
#   ⇒ ①(tick)·③(LP 코어)이 3회 측정에서 전부 눈금에 안 잡힌 진짜 이유.
#     CPU 가 CPU_MAX 에서 내려온 적이 없으니 CPU 쪽 조치는 효과가 있을 수 없었다.
#
#  이 값은 esp-matter 예제 기본값(sdkconfig.defaults.c6_thread 의 =n)이 아무 설명
#  없이 따라온 것이고, **CHIP Kconfig 자체 기본값은 y** 다. 되돌린다.
#  효과: 커미셔닝 성공 시 BLE deinit + 이미 provisioned 된 상태로 부팅하면
#        BLE 를 아예 초기화하지 않는다 → `bt` 락이 생기지 않고 RAM 도 확보된다.
#  ※재페어링하려면 factory reset 이 필요하다(자격증명이 지워지면 다음 부팅에
#    BLE 가 다시 올라온다) — Matter 표준 동작.
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y

# ★2026-08-14 802.15.4 라디오를 light sleep 중 전원차단 (절전)
#  "allows the IEEE802.15.4 module to be powered down during automatic light sleep"
#  ※light sleep 이 실제로 진입해야 의미가 있다 — 위 bt 락 해제와 세트다.
CONFIG_IEEE802154_SLEEP_ENABLE=y

# ★진단용 — 전류 측정 빌드에서는 **끌 것**(런타임 오버헤드).
#  콘솔 `pm` 이 lock 보유시간 + 절전모드 체류시간을 출력한다.
CONFIG_PM_PROFILING=y

# ★★★2026-08-14 light sleep 진입/이탈 콜백 — **NVS 로 남기기 위한 계측**
#  이 보드는 포트를 여는 순간 리셋된다(부팅진단 `리셋사유=USB리셋(플래시/포트열기)`).
#  그래서 esp_pm_dump_locks 의 RAM 통계는 **읽으러 가는 행위가 지워버린다** —
#  실제로 배터리 구간 통계를 그렇게 날렸다(2026-08-14).
#  → exit 콜백이 주는 실제 sleep_time_us 를 누적해 **배터리 로그 행(bat_sample_t.ls)**
#    에 실어 NVS 에 남긴다. 리셋과 무관하게 살아남고, 방전 기울기와 같은 표에서 본다.
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y

# ★★★2026-08-16 태스크별 CPU 점유 실측 — 콘솔 `rt` (진단 전용, 측정 끝나면 끌 것)
#
#  왜: 방전 로그가 light sleep 체류 85% 를 보여준다 → **깨어 있는 15%** 가 소비의
#  대부분(≈4.5mA / 5.34mA)인데 그 15% 를 누가 쓰는지 근거가 없었다. 메인 루프
#  100ms 를 늘리는 안은 이미 되돌린 이력이 있어(c7b4fc7 — 깨우기 경로를 늦추면
#  버튼/진동이 죽는다) 주기를 건드리기 전에 **실측**이 필요하다.
#
#  USE_TRACE_FACILITY 가 uxTaskGetSystemState 를, GENERATE_RUN_TIME_STATS 가
#  태스크별 누적 실행시간을 준다. 카운터는 esp_timer(µs) 기반.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y
